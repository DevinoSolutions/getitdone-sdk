{
    "name": "@nowgetitdone/sdk",
    "version": "0.2.0",
    "description": "Official TypeScript SDK for the GetItDone public API (https://app.nowgetitdone.com/v1).",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DevinoSolutions/getitdone-sdk.git"
    },
    "homepage": "https://nowgetitdone.com/developers",
    "bugs": {
        "url": "https://github.com/DevinoSolutions/getitdone-sdk/issues"
    },
    "keywords": [
        "getitdone",
        "api",
        "sdk",
        "tasks",
        "task-management",
        "webhooks",
        "typescript"
    ],
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./webhooks": "./src/webhooks.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.cjs",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "require": "./dist/index.cjs"
            },
            "./webhooks": {
                "types": "./dist/webhooks.d.ts",
                "import": "./dist/webhooks.js",
                "require": "./dist/webhooks.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.contract-types.json && tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests",
        "test": "vitest run",
        "size-limit": "size-limit",
        "prepublishOnly": "pnpm build"
    },
    "size-limit": [
        {
            "name": "index (ESM, as a bundler ships it)",
            "path": "dist/index.js",
            "limit": "4.1 kB"
        },
        {
            "name": "webhooks (ESM, as a bundler ships it)",
            "path": "dist/webhooks.js",
            "ignore": [
                "crypto"
            ],
            "limit": "900 B"
        },
        {
            "name": "index (CJS, the published file itself)",
            "path": "dist/index.cjs",
            "disablePlugins": [
                "@size-limit/esbuild"
            ],
            "limit": "7.6 kB"
        },
        {
            "name": "webhooks (CJS, the published file itself)",
            "path": "dist/webhooks.cjs",
            "disablePlugins": [
                "@size-limit/esbuild"
            ],
            "limit": "1.6 kB"
        }
    ],
    "dependencies": {
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@getitdone/api-contracts": "workspace:*",
        "@getitdone/auth-scopes": "workspace:*",
        "@getitdone/eslint-config": "workspace:*",
        "@getitdone/typescript-config": "workspace:*",
        "@size-limit/preset-small-lib": "12.1.0",
        "@types/node": "^20",
        "eslint": "^9.35.0",
        "size-limit": "12.1.0",
        "tsup": "8.5.1",
        "typescript": "^6.0.3",
        "vitest": "4.1.12"
    }
}
